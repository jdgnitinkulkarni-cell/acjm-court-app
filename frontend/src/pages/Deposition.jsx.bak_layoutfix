  const [settingsMsg, setSettingsMsg] = useState("");
  const [showProofread, setShowProofread] = useState(false);
  const [proofreadSuggestions, setProofreadSuggestions] = useState([]);
  const [editorHydrated, setEditorHydrated] = useState(false);
  const [editorInitialized, setEditorInitialized] = useState(false);
  const [initialContentLoading, setInitialContentLoading] = useState(true);
  const [leavingForDetails, setLeavingForDetails] = useState(false);
  const [syncStatus, setSyncStatus] = useState("loading");
  const [isNavigatingBack, setIsNavigatingBack] = useState(false);
  const [historyAvailability, setHistoryAvailability] = useState({ canUndo: false, canRedo: false });
  const [voiceEngine, setVoiceEngine] = useState("idle");
