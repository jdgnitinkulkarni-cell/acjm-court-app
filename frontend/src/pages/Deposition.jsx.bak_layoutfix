      {showRuler && (
      <div className="dep-ruler-tools">
        <strong>Ruler</strong>
        <label>Top <input type="number" value={pageMargins.top} min={MIN_PAGE_MARGIN_PX} max={MAX_PAGE_MARGIN_PX} onChange={(e) => setPageMargin("top", e.target.value)} /></label>
        <label>Left <input type="number" value={pageMargins.left} min={MIN_PAGE_MARGIN_PX} max={MAX_PAGE_MARGIN_PX} onChange={(e) => setPageMargin("left", e.target.value)} /></label>
        <label>Right <input type="number" value={pageMargins.right} min={MIN_PAGE_MARGIN_PX} max={MAX_PAGE_MARGIN_PX} onChange={(e) => setPageMargin("right", e.target.value)} /></label>
        <label>Bottom <input type="number" value={pageMargins.bottom} min={MIN_PAGE_MARGIN_PX} max={MAX_PAGE_MARGIN_PX} onChange={(e) => setPageMargin("bottom", e.target.value)} /></label>
        <button type="button" onMouseDown={noStealFocus} onClick={() => adjustSelectedParagraphIndent("paragraph", -12)}>Decrease Indent</button>
        <button type="button" onMouseDown={noStealFocus} onClick={() => adjustSelectedParagraphIndent("paragraph", 12)}>Increase Indent</button>
        <button type="button" onMouseDown={noStealFocus} onClick={() => adjustSelectedParagraphIndent("first-line", 12)}>First Line +</button>
        <button type="button" onMouseDown={noStealFocus} onClick={() => setTabStops([])}>Clear Tabs</button>
        <button type="button" onMouseDown={noStealFocus} onClick={resetRulerSettings}>Reset Ruler</button>
        <span className="hint">Double-click the horizontal ruler to add/remove a tab stop. Press Tab in the document to use it.</span>
      </div>
      )}

      <div className="dep-canvas">
        <div className="dep-ruler-grid" style={{ transform: `scale(${zoom / 100})`, transformOrigin: "top center", gridTemplateColumns: showRuler ? "32px max-content" : "0px max-content", gridTemplateRows: showRuler ? "28px max-content" : "0px max-content" }}>
          {showRuler && <div className="dep-ruler-corner" />}
          {showRuler && (
          <div className="dep-horizontal-ruler" onDoubleClick={addTabStopFromRuler}>
            <div className="dep-ruler-margin" style={{ left: 0, top: 0, width: pageMargins.left, height: 28 }} />
            <div className="dep-ruler-margin" style={{ right: 0, top: 0, width: pageMargins.right, height: 28 }} />
            {Array.from({ length: 17 }, (_, i) => i * 50).map((x, i) => (
              <React.Fragment key={x}>
                <span className="dep-ruler-tick" style={{ left: x, top: 0, width: 1, height: i % 2 === 0 ? 12 : 8 }} />
                {i % 2 === 0 && <span className="dep-ruler-label" style={{ left: x + 2, top: 12 }}>{Math.round(x / 10)}</span>}
              </React.Fragment>
            ))}
            <span className="dep-ruler-marker left" title="Left margin — drag to adjust" style={{ left: pageMargins.left }} onMouseDown={startMarginDrag("left")} />
            <span className="dep-ruler-marker right" title="Right margin — drag to adjust" style={{ left: PAGE_WIDTH_PX - pageMargins.right }} onMouseDown={startMarginDrag("right")} />
            {tabStops.map((stop) => (
              <span key={stop} className="dep-ruler-marker tab" title={`Tab stop ${stop}px — drag to move, double-click to remove`} style={{ left: pageMargins.left + stop }} onMouseDown={startTabDrag(stop)} />
            ))}
            <span className="dep-ruler-marker indent-firstline" title="First-line indent — drag to adjust" style={{ left: pageMargins.left + indentMarkers.left + indentMarkers.firstLine }} onMouseDown={startIndentDrag("first-line")} />
            <span className="dep-ruler-marker indent-left" title="Paragraph indent — drag to adjust" style={{ left: pageMargins.left + indentMarkers.left }} onMouseDown={startIndentDrag("paragraph")} />
          </div>
          )}
          {showRuler && (
          <div className="dep-vertical-ruler">
            <div className="dep-ruler-margin" style={{ left: 0, top: 0, width: 32, height: pageMargins.top }} />
            <div className="dep-ruler-margin" style={{ left: 0, bottom: 0, width: 32, height: pageMargins.bottom }} />
            <span className="dep-ruler-marker-v top" title="Top margin — drag to adjust" style={{ top: pageMargins.top }} onMouseDown={startMarginDrag("top")} />
            <span className="dep-ruler-marker-v bottom" title="Bottom margin — drag to adjust" style={{ top: PAGE_HEIGHT_PX - pageMargins.bottom }} onMouseDown={startMarginDrag("bottom")} />
            {Array.from({ length: 23 }, (_, i) => i * 50).map((y, i) => (
              <React.Fragment key={y}>
                <span className="dep-ruler-tick" style={{ left: 20, top: y, width: i % 2 === 0 ? 10 : 6, height: 1 }} />
                {i % 2 === 0 && <span className="dep-ruler-label" style={{ left: 2, top: y + 2 }}>{Math.round(y / 10)}</span>}
              </React.Fragment>
            ))}
          </div>
          )}
          <div className="dep-page-area">
            {rulerGuide?.x != null && <div className="dep-ruler-guide-v" style={{ left: rulerGuide.x }} />}
            {rulerGuide?.y != null && <div className="dep-ruler-guide-h" style={{ top: rulerGuide.y }} />}
            <div
              ref={setEditorNode}
              className="dep-page"
              contentEditable
              suppressContentEditableWarning
              spellCheck={false}
              lang={SPEECH_LOCALE[dep.language] || "gu-IN"}
              style={{
                fontFamily: FONT_BY_LANG[dep.language] || FONT_BY_LANG.gu, fontSize: fontSize + "pt", lineHeight: 1.5,
                padding: `${pageMargins.top}px ${pageMargins.right}px ${pageMargins.bottom}px ${pageMargins.left}px`,
              }}
              onBeforeInput={onEditorBeforeInput}
              onInput={onEditorInput}
              onKeyDown={onEditorKeyDown}
              onPaste={onEditorPaste}
              onCompositionStart={onEditorCompositionStart}
              onCompositionEnd={onEditorCompositionEnd}
              onClick={onEditorClick}
              onMouseDown={onEditorMouseDown}
              data-testid="deposition-editor"
            />
          </div>
        </div>
      </div>

      {cropTarget && (
        <ImageCropModal img={cropTarget} onCancel={() => setCropTarget(null)} onApply={applyCrop} />
      )}

      <div className="dep-bottombar">
        <div className="grp">
          <button
            style={{ background: "#4b5563", color: "#fff" }}
            disabled={leavingForDetails}
            onClick={saveAndOpenWitnessDetails}
          >
            {leavingForDetails ? "Saving..." : "← Back"}
          </button>
          <span>⏱ {elapsed}</span>
          <span>Words: {wordCount}</span>
          <span>Lang: {dep.language?.toUpperCase()}</span>
          <span>Zoom:</span>
          <input type="range" min={50} max={150} value={zoom} onChange={(e) => setZoom(+e.target.value)} />
          <span>{zoom}%</span>
          {renderSyncStatus()}
          {renderVoiceEngineStatus()}
        </div>
        <div className="grp">
          <button style={{ background: "#f59e0b" }} onClick={() => alert("Demand / OCR-relay workflow is planned for a later phase — this button is a placeholder for now.")}>Demand</button>
          <button style={{ background: "#7c3aed", color: "#fff" }} onMouseDown={saveSelectionBeforeFocusLoss} onClick={doHostile}>Hostile</button>
          <button style={{ background: "#2563eb", color: "#fff" }} onMouseDown={saveSelectionBeforeFocusLoss} onClick={doStartCross}>Start Cross</button>
          <button style={{ background: "#16a34a", color: "#fff" }} onClick={doComplete}>Complete</button>
          <button style={{ background: "#dc2626", color: "#fff" }} onClick={openAdjourn}>Adjourn</button>
        </div>
      </div>

      {showAdjourn && (
        <div className="modal-backdrop" onClick={() => setShowAdjourn(false)}>
          <div className="modal" onClick={(e) => e.stopPropagation()} style={{ maxWidth: 560 }}>
            <h3>Adjourn Deposition</h3>
            <div className="form-grid">
              <label>Reason to Adjourn</label>
              <textarea
                value={adjournReason}
                onChange={(e) => setAdjournReason(e.target.value)}
                rows={3}
                style={{ width: "100%", resize: "vertical", fontFamily: "inherit", fontSize: 15, padding: "10px 12px", border: "1px solid var(--border)", borderRadius: 4 }}
                data-testid="adjourn-reason-input"
              />
              <label>Next Date &amp; Time</label>
              <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
                <input
                  type="date"
                  value={adjournNextDate.split("T")[0] || ""}
                  onChange={(e) => setAdjournNextDate(`${e.target.value}T${adjournNextDate.split("T")[1] || "10:00"}`)}
                  style={{ flex: 1 }}
                  data-testid="adjourn-date-input"
                />
                <input
                  type="time"
                  value={adjournNextDate.split("T")[1] || ""}
                  onChange={(e) => setAdjournNextDate(`${adjournNextDate.split("T")[0] || new Date().toISOString().slice(0, 10)}T${e.target.value}`)}
                  style={{ width: 120 }}
                  data-testid="adjourn-time-input"
                />
              </div>
              <label>Adjourned For</label>
              <select value={adjournFor} onChange={(e) => setAdjournFor(e.target.value)}>
                <option value="further_chief">Further Chief</option>
                <option value="cross">Cross Examination</option>
              </select>
            </div>
            <div className="modal-actions">
              <button className="btn btn-secondary" onClick={() => setShowAdjourn(false)}>Cancel</button>
              <button className="btn btn-primary" onClick={submitAdjourn}>Submit</button>
            </div>
          </div>
        </div>
      )}

      {pdfPreview && (
        <div className="modal-backdrop" onClick={closePdfPreview}>
          <div className="modal" onClick={(e) => e.stopPropagation()} style={{ width: "min(96vw, 1000px)", maxWidth: "1000px" }}>
            <h3>Deposition PDF Preview</h3>
            <iframe
              title="Deposition PDF Preview"
              src={pdfPreview.url}
              style={{ width: "100%", height: "72vh", border: "1px solid var(--border)", borderRadius: 4, background: "#fff" }}
            />
            <div className="modal-actions">
              <button className="btn btn-secondary" onClick={closePdfPreview}>Close</button>
              <button className="btn btn-primary" onClick={downloadPdfPreview}>Download PDF</button>
            </div>
          </div>
        </div>
      )}

      {showProofread && (
        <div className="modal-backdrop" onClick={() => setShowProofread(false)}>
          <div className="modal" onClick={(e) => e.stopPropagation()} style={{ maxWidth: 820 }}>
            <h3>Legal Proofread</h3>
            <p className="hint">
              Review each suggestion before applying. The original deposition text is changed only after you accept.
            </p>
            {proofreadSuggestions.length === 0 ? (
              <p>No capitalization, punctuation, spelling, or legal-language suggestion found.</p>
            ) : (
              <div style={{ maxHeight: 420, overflow: "auto", display: "grid", gap: 10 }}>
                {proofreadSuggestions.map((item) => (
                  <div key={item.id} style={{ border: "1px solid var(--border)", borderRadius: 6, padding: 10, background: "#fff" }}>
                    <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 10 }}>
                      <div>
                        <strong>Original</strong>
                        <p style={{ whiteSpace: "pre-wrap", margin: "6px 0 0" }}>{item.original.trim()}</p>
                      </div>
                      <div>
                        <strong>Suggested</strong>
                        <textarea
                          value={item.suggested}
                          onChange={(event) => updateProofreadSuggestion(item.id, event.target.value)}
                          spellCheck={false}
                          rows={Math.max(3, Math.min(8, item.suggested.split(/\r?\n/).length + 2))}
                          style={{
                            width: "100%",
                            minHeight: 86,
                            marginTop: 6,
                            color: "#166534",
                            border: "1px solid var(--border)",
                            borderRadius: 4,
                            padding: 8,
                            font: "inherit",
                            resize: "vertical",
                            whiteSpace: "pre-wrap",
                          }}
                        />
                      </div>
                    </div>
                    <div className="modal-actions" style={{ marginTop: 10 }}>
                      <button className="btn btn-secondary" onClick={() => rejectProofreadSuggestion(item.id)}>Reject</button>
                      <button className="btn btn-primary" onClick={() => acceptProofreadSuggestions([item.id])}>Accept</button>
                    </div>
                  </div>
                ))}
              </div>
            )}
            <div className="modal-actions">
              <button className="btn btn-secondary" onClick={() => setShowProofread(false)}>Close</button>
              {proofreadSuggestions.length > 0 && (
                <button className="btn btn-primary" onClick={() => acceptProofreadSuggestions()}>Accept All</button>
              )}
            </div>
          </div>
        </div>
      )}

      {showSettings && (
        <div className="modal-backdrop" onClick={() => setShowSettings(false)}>
          <div className="modal" onClick={(e) => e.stopPropagation()} style={{ maxWidth: 560 }}>
            <h3>Deposition Settings</h3>
            <p className="hint" style={{ color: "#7c3aed" }}>
              These settings apply <strong>only to your own Judge account</strong> — they are not shared
              with, or applied to, any other Judge. More settings will be added here over time.
            </p>
            <div className="form-grid">
              <label>Language</label>
              <select value={settingsLang} onChange={(e) => switchSettingsLang(e.target.value)}>
                {LANG_OPTIONS.map((o) => <option key={o.value} value={o.value}>{o.label}</option>)}
              </select>
              <label>Custom "Hostile" paragraph (optional)</label>
              <div>
                <textarea
                  value={settingsHostile}
                  onChange={(e) => setSettingsHostile(e.target.value)}
                  rows={4}
                  placeholder="Leave blank to use the standard wording"
                  style={{ width: "100%", resize: "vertical", fontFamily: "inherit", fontSize: 14, padding: "10px 12px", border: "1px solid var(--border)", borderRadius: 4 }}
                />
                <button type="button" className="btn btn-outline" style={{ padding: "4px 10px", marginTop: 4 }} onClick={() => setSettingsHostile("")}>
                  Reset to Default
                </button>
              </div>
              <label>Custom "Start Cross" line (optional)</label>
              <div>
                <textarea
                  value={settingsStartCross}
                  onChange={(e) => setSettingsStartCross(e.target.value)}
                  rows={2}
                  placeholder="Leave blank to use the standard wording"
                  style={{ width: "100%", resize: "vertical", fontFamily: "inherit", fontSize: 14, padding: "10px 12px", border: "1px solid var(--border)", borderRadius: 4 }}
                />
                <button type="button" className="btn btn-outline" style={{ padding: "4px 10px", marginTop: 4 }} onClick={() => setSettingsStartCross("")}>
                  Reset to Default
                </button>
              </div>
            </div>
            {settingsMsg && <p className="hint" style={{ color: "#16a34a" }}>{settingsMsg}</p>}
            <div className="modal-actions">
              <button className="btn btn-secondary" onClick={() => setShowSettings(false)}>Close</button>
              <button className="btn btn-primary" onClick={saveSettings}>Save</button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
