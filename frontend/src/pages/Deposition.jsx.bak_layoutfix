      await api.put(`/depositions/${depId}`, { ...form, case_specific_details: caseSpecificDetails });
      navigate(`/judge-desk/oral-evidence/deposition/type/${depId}`);
    } catch (e) {
      setMsg(e.response?.data?.detail || "Failed to save.");
      setSaving(false);
    }
  };

  if (!dep || !form) return <div className="app-shell"><TopBar title="Deposition" /><div className="page">Loading...</div></div>;

  return (
    <div className="app-shell">
      <TopBar title="Deposition" />
      <div className={`page dep-entry-lang-${form.language || "gu"}`}>
        <h1>New Deposition</h1>
        <p className="hint">Case No: <strong>{dep.primary_case_number}</strong> — Sr. No. {dep.sr_no}</p>
        <div className="form-grid">
