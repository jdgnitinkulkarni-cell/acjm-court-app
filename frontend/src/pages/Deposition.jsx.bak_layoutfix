    commitTypingHistory(ordered ? "before-ordered-list" : "before-bullet-list");
    captureHistoryBefore(ordered ? "ordered-list" : "bullet-list");
    editorRef.current?.focus();
    const tagName = ordered ? "OL" : "UL";
    const sel = window.getSelection();

