function preserveReplacementCase(original, replacement) {
  if (!original) return replacement;
  if (original === original.toUpperCase()) return replacement.toUpperCase();
  if (original[0] === original[0].toUpperCase()) {
    return replacement[0].toUpperCase() + replacement.slice(1);
  }
  return replacement;
}

function applySafeEnglishSpellingCorrections(text = "") {
  return SAFE_ENGLISH_SPELLING_CORRECTIONS.reduce((current, [wrong, right]) => (
    current.replace(new RegExp(`\\b${escapeRegExp(wrong)}\\b`, "gi"), (match) => preserveReplacementCase(match, right))
  ), text);
}

function applyLegalLanguageCorrections(text = "") {
  return LEGAL_LANGUAGE_CORRECTIONS.reduce((current, { pattern, replacement }) => (
    current.replace(pattern, replacement)
  ), text);
}

function capitalizeEnglishSentenceStarts(text = "") {
  return String(text || "").replace(/(^|[.!?]\s+)([a-z])/g, (match, lead, letter) => lead + letter.toUpperCase());
}

function normalizeProofreadSpacingAndPunctuation(text = "") {
  return String(text || "")
    .replace(/[\t\u00a0 ]{2,}/g, " ")
    .replace(/\s+([,.?!])/g, "$1")
    .replace(/([,.?!])(?=\S)/g, "$1 ")
    .replace(/\btoday\s+(the\s+(?:accused|complainant|witness)\b)/gi, "today. $1")
    .replace(/\btoday\s+(the\s+(?:advocate|counsel)\b)/gi, "today. $1")
    .replace(/\bpresent\s+(the\s+(?:accused|complainant|witness)\b)/gi, "present. $1")
    .replace(/\bpresent\s+(the\s+(?:advocate|counsel)\b)/gi, "present. $1")
    .replace(/\bCourt\s+(the\s+(?:accused|complainant|witness)\b)/g, "Court. $1");
}

function applySafeGrammarCorrections(text = "") {
  return capitalizeEnglishSentenceStarts(
    normalizeProofreadSpacingAndPunctuation(
      applyLegalLanguageCorrections(
        applySafeEnglishSpellingCorrections(
          normalizeSpokenEditorCommands(text)
        )
      )
    )
  );
}

function normalizeProofreadComparison(text = "") {
  return String(text || "")
    .replace(/\u00a0/g, " ")
    .replace(/[ \t]+/g, " ")
    .replace(/\s+([,.?!])/g, "$1")
    .replace(/([,.?!])(?=\S)/g, "$1 ")
    .trim();
}

function splitProofreadSegments(text = "") {
  const value = String(text || "");
  const segments = [];
  let start = 0;

  for (let index = 0; index < value.length; index += 1) {
    const char = value[index];
    const isSentenceEnd = char === "." || char === "?" || char === "!" || char === "\n";
    if (!isSentenceEnd) continue;

    let end = index + 1;
    while (end < value.length && /[\s\u00a0]/.test(value[end])) end += 1;
    segments.push({ start, end, text: value.slice(start, end) });
    start = end;
  }

  if (start < value.length) {
    segments.push({ start, end: value.length, text: value.slice(start) });
  }

  return segments.filter((segment) => /[\p{L}\p{N}]/u.test(segment.text));
}

function normalizeSpokenPunctuationInElement(root) {
  if (!root) return false;
  const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
    acceptNode: (node) => {
      const parent = node.parentElement;
      if (!parent || parent.closest(".dep-img-wrap,.dep-table-drop-marker,script,style")) return NodeFilter.FILTER_REJECT;
      return NodeFilter.FILTER_ACCEPT;
    },
  });
  const nodes = [];
  while (walker.nextNode()) nodes.push(walker.currentNode);
  let changed = false;
  nodes.forEach((node) => {
    const next = normalizeSpokenPunctuationText(node.nodeValue || "");
    if (next !== node.nodeValue) {
      node.nodeValue = next;
      changed = true;
    }
  });
  return changed;
}

function applyLiveGrammarCorrectionsInTextNode(node, offset) {
  if (!node || node.nodeType !== Node.TEXT_NODE) return { changed: false, offset };
  const beforeText = node.nodeValue || "";
  const beforeCaretText = beforeText.slice(0, offset);
  const afterText = capitalizeEnglishSentenceStarts(normalizeSpokenPunctuationText(beforeText));
  if (afterText === beforeText) return { changed: false, offset };
  node.nodeValue = afterText;
  return {
    changed: true,
    offset: Math.min(capitalizeEnglishSentenceStarts(normalizeSpokenPunctuationText(beforeCaretText)).length, afterText.length),
  };
}

function partyName(c) {
  const a = c.complainant_name || "-";
  const b = c.accused_name || "-";
  return `${a} Vs ${b}`;
}

// Type-to-filter case picker. Renders nothing until the user types at least
// one character, so it stays fast and usable even with a docket of
// thousands of cases (no giant list is ever rendered at once).
function CaseSearchAdd({ cases, selected, onAdd }) {
  const [term, setTerm] = useState("");
  const [open, setOpen] = useState(false);
  const matches = useMemo(() => {
    const t = term.trim().toLowerCase();
    if (!t) return [];
    return cases
      .filter((c) => !selected.includes(c.case_number))
      .filter((c) => c.case_number.toLowerCase().includes(t) || partyName(c).toLowerCase().includes(t))
      .slice(0, 30);
  }, [term, cases, selected]);

  const pick = (num) => {
    onAdd(num);
    setTerm("");
    setOpen(false);
  };

  return (
    <div style={{ position: "relative", maxWidth: 520 }}>
      <input
        value={term}
        onChange={(e) => { setTerm(e.target.value); setOpen(true); }}
        onFocus={() => setOpen(true)}
        placeholder="Type a case number to search…"
        data-testid="case-search-input"
        style={{ width: "100%", border: "1.5px solid var(--border)", borderRadius: 4, padding: "10px 12px", fontFamily: "inherit", fontSize: 15 }}
      />
      {open && term.trim() && (
        <div
          style={{
            position: "absolute", top: "calc(100% + 4px)", left: 0, right: 0, zIndex: 30,
            background: "#fff", border: "1px solid #777", boxShadow: "0 8px 18px rgba(0,0,0,.12)",
            maxHeight: 260, overflowY: "auto",
          }}
        >
          {matches.length === 0 && <div style={{ padding: "10px 12px", color: "#6b7280" }}>No matching case found.</div>}
          {matches.map((c) => (
            <div
              key={c.case_number}
              // onMouseDown+preventDefault keeps focus (and the open dropdown)
              // alive until the click actually registers — without this, the
              // input's blur fires first and closes the list before the
              // click can land (the exact bug found in the Application
              // complainant-selection combo).
              onMouseDown={(e) => e.preventDefault()}
              onClick={() => pick(c.case_number)}
              style={{ padding: "9px 12px", cursor: "pointer", borderBottom: "1px solid #f1f1f1" }}
              onMouseEnter={(e) => (e.currentTarget.style.background = "#eef2ff")}
              onMouseLeave={(e) => (e.currentTarget.style.background = "")}
            >
              <strong>{c.case_number}</strong> — {partyName(c)}
            </div>
          ))}
        </div>
      )}
    </div>
  );
}

// Small reusable mic button for any plain <input>/<textarea> outside the main
// typing page (e.g. the Reason-to-Adjourn field). Uses the same Web Speech
// API pattern as the main Typing Page's mic.
function FieldMic({ value, onChange, lang = "gu" }) {
  const [on, setOn] = useState(false);
  const recRef = useRef(null);
  useEffect(() => () => recRef.current?.stop(), []);
  const toggle = () => {
    const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SR) { alert("Voice typing is not supported in this browser."); return; }
    if (on) { recRef.current?.stop(); setOn(false); return; }
    const rec = new SR();
    rec.lang = SPEECH_LOCALE[lang] || "gu-IN";
    rec.continuous = true;
    rec.interimResults = false;
    rec.onresult = (ev) => {
      let text = "";
      for (let i = ev.resultIndex; i < ev.results.length; i++) {
        if (ev.results[i].isFinal) text += ev.results[i][0].transcript;
      }
      if (text) onChange((value ? value + " " : "") + normalizeSpokenEditorCommands(text.trim()));
    };
    rec.onend = () => { if (on) rec.start(); };
    rec.start();
    recRef.current = rec;
    setOn(true);
  };
  return (
    <button
      type="button"
      onClick={toggle}
      title="Voice typing"
      aria-label="Voice typing"
      style={{
        marginLeft: 8, width: 38, height: 38, borderRadius: "50%", border: "none",
        background: on ? "#16a34a" : "#dc2626", color: "#fff", cursor: "pointer",
        display: "inline-flex", alignItems: "center", justifyContent: "center", flexShrink: 0,
      }}
    >
      🎙
    </button>
  );
}

// Simple Word-style crop tool: shows the image at a fixed display size with
// a draggable/resizable crop rectangle overlaid on top. On Apply, the
// selected region is drawn onto a canvas at the image's full natural
// resolution and the <img> element's src is replaced with the result.
function ImageCropModal({ img, onCancel, onApply }) {
  const DISPLAY_W = 480;
  const naturalW = img.naturalWidth || img.width || 480;
  const naturalH = img.naturalHeight || img.height || 320;
  const scale = DISPLAY_W / naturalW;
  const displayH = naturalH * scale;

  const [rect, setRect] = useState({ x: displayH ? DISPLAY_W * 0.1 : 0, y: displayH * 0.1, w: DISPLAY_W * 0.8, h: displayH * 0.8 });
  const dragRef = useRef(null);

  const startDrag = (mode) => (e) => {
    e.preventDefault();
    dragRef.current = { mode, startX: e.clientX, startY: e.clientY, rect: { ...rect } };
  };
  useEffect(() => {
    const onMove = (e) => {
      const d = dragRef.current;
      if (!d) return;
      const dx = e.clientX - d.startX;
      const dy = e.clientY - d.startY;
      setRect(() => {
        let { x, y, w, h } = d.rect;
        if (d.mode === "move") { x = d.rect.x + dx; y = d.rect.y + dy; }
        else if (d.mode === "se") { w = Math.max(20, d.rect.w + dx); h = Math.max(20, d.rect.h + dy); }
        else if (d.mode === "nw") { x = d.rect.x + dx; y = d.rect.y + dy; w = Math.max(20, d.rect.w - dx); h = Math.max(20, d.rect.h - dy); }
        x = Math.max(0, Math.min(x, DISPLAY_W - 10));
        y = Math.max(0, Math.min(y, displayH - 10));
        w = Math.min(w, DISPLAY_W - x);
        h = Math.min(h, displayH - y);
        return { x, y, w, h };
      });
    };
    const onUp = () => { dragRef.current = null; };
    document.addEventListener("mousemove", onMove);
    document.addEventListener("mouseup", onUp);
    return () => { document.removeEventListener("mousemove", onMove); document.removeEventListener("mouseup", onUp); };
  }, [displayH]); // eslint-disable-line react-hooks/exhaustive-deps

  const apply = () => {
    const canvas = document.createElement("canvas");
    const sx = rect.x / scale, sy = rect.y / scale, sw = rect.w / scale, sh = rect.h / scale;
    canvas.width = sw;
    canvas.height = sh;
    const ctx = canvas.getContext("2d");
    ctx.drawImage(img, sx, sy, sw, sh, 0, 0, sw, sh);
    onApply(canvas.toDataURL("image/png"));
  };

  return (
    <div className="modal-backdrop" onClick={onCancel}>
      <div className="modal" onClick={(e) => e.stopPropagation()} style={{ maxWidth: DISPLAY_W + 60 }}>
        <h3>Crop Image</h3>
        <p className="hint">Drag the box to move it, or drag its corners to resize, then click Apply.</p>
        <div style={{ position: "relative", width: DISPLAY_W, height: displayH, background: "#000" }}>
          <img src={img.src} alt="" style={{ width: DISPLAY_W, height: displayH, display: "block", opacity: 0.5 }} />
          <div
            onMouseDown={startDrag("move")}
            style={{
              position: "absolute", left: rect.x, top: rect.y, width: rect.w, height: rect.h,
              border: "2px dashed #fff", cursor: "move", boxShadow: "0 0 0 2000px rgba(0,0,0,.4)",
            }}
          >
            <div onMouseDown={(e) => { e.stopPropagation(); startDrag("nw")(e); }}
              style={{ position: "absolute", top: -6, left: -6, width: 12, height: 12, background: "#fff", cursor: "nwse-resize" }} />
            <div onMouseDown={(e) => { e.stopPropagation(); startDrag("se")(e); }}
              style={{ position: "absolute", bottom: -6, right: -6, width: 12, height: 12, background: "#fff", cursor: "nwse-resize" }} />
          </div>
        </div>
        <div className="modal-actions">
          <button className="btn btn-secondary" onClick={onCancel}>Cancel</button>
          <button className="btn btn-primary" onClick={apply}>Apply</button>
        </div>
      </div>
    </div>
  );
}

const WIZARD_STORAGE_KEY = "dep_wizard_state_v1";
function loadWizardState() {
  try { return JSON.parse(sessionStorage.getItem(WIZARD_STORAGE_KEY) || "null"); }
  catch (e) { return null; }
}
function saveWizardState(state) {
  try { sessionStorage.setItem(WIZARD_STORAGE_KEY, JSON.stringify(state)); }
  catch (e) { /* storage unavailable — non-fatal, just means data won't survive navigation */ }
}
function clearWizardState() {
  try { sessionStorage.removeItem(WIZARD_STORAGE_KEY); } catch (e) { /* ignore */ }
}

function countDepositionWords(text) {
  const normalized = String(text || "").replace(/\u00a0/g, " ").trim();
  if (!normalized) return 0;
  return (normalized.match(/[\p{L}\p{N}]+(?:['’][\p{L}\p{N}]+)?/gu) || []).length;
}

function parseDepositionDateTime(value) {
  if (!value) return null;
  const raw = String(value).trim();
  const parsed = new Date(raw);
  if (!Number.isNaN(parsed.getTime())) return parsed;
  const match = raw.match(/^(\d{1,2}):(\d{2}):(\d{2}),\s*(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
  if (!match) return null;
  const [, hh, mm, ss, dd, mo, yyyy] = match;
  const dt = new Date(Number(yyyy), Number(mo) - 1, Number(dd), Number(hh), Number(mm), Number(ss));
  return Number.isNaN(dt.getTime()) ? null : dt;
}

function formatElapsedTime(start, end = new Date()) {
  if (!start) return "00:00:00";
  const diff = Math.max(0, end.getTime() - start.getTime());
  const h = String(Math.floor(diff / 3600000)).padStart(2, "0");
  const m = String(Math.floor((diff % 3600000) / 60000)).padStart(2, "0");
  const s = String(Math.floor((diff % 60000) / 1000)).padStart(2, "0");
  return `${h}:${m}:${s}`;
}

const PAGE_WIDTH_PX = 794;
const PAGE_HEIGHT_PX = 1123;
const MIN_PAGE_MARGIN_PX = 24;
const MAX_PAGE_MARGIN_PX = 160;
const DEFAULT_PAGE_MARGINS = { top: 70, right: 70, bottom: 70, left: 70 };
const RULER_SETTINGS_KEY = "dep_ruler_settings_v1";

function clampNumber(value, min, max) {
  const n = Number(value);
  if (!Number.isFinite(n)) return min;
  return Math.max(min, Math.min(max, n));
}

function loadRulerSettings() {
  try {
    const saved = JSON.parse(localStorage.getItem(RULER_SETTINGS_KEY) || "null");
    return {
      margins: { ...DEFAULT_PAGE_MARGINS, ...(saved?.margins || {}) },
      tabStops: Array.isArray(saved?.tabStops) ? saved.tabStops : [96, 192, 288, 384],
    };
  } catch (e) {
    return { margins: DEFAULT_PAGE_MARGINS, tabStops: [96, 192, 288, 384] };
  }
}

export default function DepositionWizard() {
  const navigate = useNavigate();
  const user = getUser();
  const courts = user?.courts || [];
  const saved = loadWizardState() || {};
  const [courtId, setCourtId] = useState(saved.courtId || courts[0]?.id || "");
  const [cases, setCases] = useState([]);
  const [selected, setSelected] = useState(saved.selected || []);
  const [activeCaseNumber, setActiveCaseNumber] = useState(saved.activeCaseNumber || "");
  const [showLinked, setShowLinked] = useState(false);
  const [step, setStep] = useState(saved.step || "select-cases");
  const [mode, setMode] = useState(saved.mode || null);
  const [clientStartTime, setClientStartTime] = useState(saved.clientStartTime || null);
  const [existingList, setExistingList] = useState([]);
  const [existingId, setExistingId] = useState(saved.existingId || "");
  const [msg, setMsg] = useState("");
  const [submitting, setSubmitting] = useState(false);

  const [form, setForm] = useState(saved.form || {
    exhibit_number: "", sr_no: "", witness_name: "", father_husband_name: "",
    religion: "", age: "", occupation: "", address: "", contact_no: "",
    language: "gu", stage: "chief", producing_party: "", defending_party: "",
    advocate_producing: "", advocate_defending: "", av_conferencing: false, vulnerable_witness: false,
  });
  // Per-case Exhibit No. / Sr. No. overrides, keyed by case_number, for cases
  // other than the primary one — the same witness can carry different
  // exhibit/serial numbers across joint cases.
  const [caseSpecificDetails, setCaseSpecificDetails] = useState(saved.caseSpecificDetails || {});

  // Persist on every change, so leaving this page (Back button — whether the
  // wizard's own, the shared TopBar's, or the browser's — and unmounting the
  // component) and returning restores exactly where the user left off,
  // instead of silently discarding selected cases and typed-in details.
  useEffect(() => {
    saveWizardState({ courtId, selected, activeCaseNumber, step, mode, clientStartTime, existingId, form, caseSpecificDetails });
  }, [courtId, selected, activeCaseNumber, step, mode, clientStartTime, existingId, form, caseSpecificDetails]);

  useEffect(() => {
    if (!courtId) return;
    api.get("/local-cases", { params: { court_id: courtId } }).then(({ data }) => setCases(data));
  }, [courtId]);

  useEffect(() => {
    // If we restored into the form step in "existing" mode (e.g. after
    // navigating away and back), the witness list itself wasn't persisted —
    // re-fetch it so the dropdown isn't empty.
    if (step === "form" && mode === "existing" && existingList.length === 0 && activeCaseNumber && courtId) {
      api.get("/depositions/existing-witnesses", { params: { case_number: activeCaseNumber, court_id: courtId } })
        .then(({ data }) => setExistingList(data));
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  const toggleCase = (num) => {
    setSelected((prev) => (prev.includes(num) ? prev.filter((c) => c !== num) : [...prev, num]));
    if (!activeCaseNumber) setActiveCaseNumber(num);
  };

  useEffect(() => {
    if (selected.length > 0 && !selected.includes(activeCaseNumber)) setActiveCaseNumber(selected[0]);
    if (selected.length === 0) setActiveCaseNumber("");
  }, [selected]); // eslint-disable-line react-hooks/exhaustive-deps

  const activeCase = cases.find((c) => c.case_number === activeCaseNumber);
  const linkedCases = cases.filter((c) => selected.includes(c.case_number) && c.case_number !== activeCaseNumber);

  const goToModeStep = () => {
    if (selected.length === 0) { setMsg("Please select at least one case."); return; }
    setMsg("");
    setStep("mode");
  };

  const goBackFromWizard = () => {
    setMsg("");
    if (step === "select-cases") {
      navigate("/judge-desk/oral-evidence");
      return;
    }
    if (step === "mode") {
      setStep("select-cases");
      return;
    }
    if (step === "form") {
      setStep("mode");
      return;
    }
    if (step === "confirm") {
      setStep("form");
    }
  };

  const chooseMode = async (m) => {
    setMode(m);
    setClientStartTime(new Date().toISOString());
    setExistingId("");
    if (m === "existing") {
      const { data } = await api.get("/depositions/existing-witnesses", {
        params: { case_number: activeCaseNumber, court_id: courtId },
      });
      setExistingList(data);
    }
    setStep("form");
  };

  const pickExistingWitness = (id) => {
    setExistingId(id);
    const w = existingList.find((x) => x.id === id);
    if (w) {
      const language = w.language || "gu";
      setForm((f) => ({
        ...f,
        exhibit_number: w.exhibit_number || "",
        sr_no: w.sr_no || "",
        witness_name: w.witness_name || "",
        father_husband_name: w.father_husband_name || "",
        religion: w.religion || "",
        age: w.age || "",
        occupation: w.occupation || "",
        address: w.address || "",
        contact_no: w.contact_no || "",
        language,
        stage: w.adjourn_for === "further_chief" ? "chief" : (w.stage || "cross"),
        producing_party: w.producing_party || "",
        defending_party: w.defending_party || "",
        advocate_producing: w.advocate_producing || "",
        advocate_defending: w.advocate_defending || "",
        av_conferencing: !!w.av_conferencing,
        vulnerable_witness: !!w.vulnerable_witness,
      }));
      setCaseSpecificDetails(w.case_specific_details || {});
      localStorage.setItem("acjm_mic_lang", language);
    }
  };

  const setProducing = (val) => {
    setForm((f) => ({ ...f, producing_party: val, defending_party: AUTO_OPPOSITE[val] || f.defending_party }));
  };

  const canProceedForm = () => {
    if (mode === "existing" && !existingId) return false;
    if (!form.exhibit_number || !form.sr_no || !form.witness_name) return false;
    if (!form.producing_party || !form.defending_party) return false;
    return true;
  };

  const openConfirm = () => {
    if (!canProceedForm()) { setMsg("Please complete all required fields."); return; }
    setMsg("");
    if (localStorage.getItem(SKIP_CONFIRM_KEY()) === "1") { doCreate(); return; }
    setStep("confirm");
  };

  const doCreate = async () => {
    setSubmitting(true);
    setMsg("");
    try {
      const payload = {
        court_id: courtId, case_ids: selected, primary_case_number: activeCaseNumber, mode,
        resume_of: mode === "existing" ? existingId : null, client_start_time_iso: clientStartTime,
        case_specific_details: caseSpecificDetails, ...form,
      };
      const { data } = await api.post("/depositions", payload);
      clearWizardState();
      navigate(`/judge-desk/oral-evidence/deposition/type/${data.id}`);
    } catch (e) {
      setMsg(e.response?.data?.detail || "Failed to start deposition");
      setSubmitting(false);
    }
  };

  return (
    <div className="app-shell">
      <TopBar title="Deposition" onBack={goBackFromWizard} />
      <div className={`page dep-entry-lang-${form.language || "gu"}`} data-testid="deposition-wizard">
        {courts.length > 1 && (
          <div className="form-grid" style={{ marginBottom: 16 }}>
            <label>Court</label>
            <select value={courtId} onChange={(e) => { setCourtId(e.target.value); setSelected([]); }}>
              {courts.map((c) => <option key={c.id} value={c.id}>{c.english?.court_name}</option>)}
            </select>
          </div>
        )}

        {step === "select-cases" && (
          <>
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
              <h1 style={{ margin: 0 }}>Select Case(s)</h1>
              {selected.length > 0 && (
                <button
                  className="btn btn-outline"
                  style={{ padding: "4px 10px" }}
                  onClick={() => { if (window.confirm("Clear the selected case(s) and any details entered so far?")) { clearWizardState(); window.location.reload(); } }}
                >
                  Start Over
                </button>
              )}
            </div>
            <p className="hint">
              Start typing a case number to search — the list narrows as you type. Click a result to add
              it. If this single deposition is to be placed in multiple joint cases, add all of them; your
              earlier selections are remembered as you navigate.
            </p>
            <CaseSearchAdd
              cases={cases}
              selected={selected}
              onAdd={(num) => toggleCase(num)}
            />
            {selected.length > 0 && (
              <table className="entries" style={{ marginTop: 16 }}>
                <thead><tr><th>Case Number</th><th>Party Name</th><th></th></tr></thead>
                <tbody>
                  {selected.map((num) => {
                    const c = cases.find((x) => x.case_number === num) || { case_number: num };
                    return (
                      <tr key={num}>
                        <td>{num}</td>
                        <td>{partyName(c)}</td>
                        <td><button className="btn btn-outline" style={{ padding: "4px 10px" }} onClick={() => toggleCase(num)}>Remove</button></td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            )}
            {cases.length === 0 && <p className="hint">No cases found for this Court.</p>}
            {msg && <p className="error">{msg}</p>}
            <div className="form-actions">
              <button className="btn btn-secondary" onClick={goBackFromWizard}>Back</button>
              <button className="btn btn-primary" onClick={goToModeStep}>Continue</button>
            </div>
          </>
        )}

        {step === "mode" && (
          <>
            <p className="hint" style={{ marginBottom: 2 }}>Case No: <strong>{activeCaseNumber}</strong></p>
            <h1>{partyName(activeCase || {})}</h1>
            {linkedCases.length > 0 && (
              <p>
                <button className="btn btn-outline" style={{ padding: "4px 10px" }} onClick={() => setShowLinked((s) => !s)}>
                  {showLinked ? "Hide" : "See the details of other linked cases"}
                </button>
              </p>
            )}
            {showLinked && <ul>{linkedCases.map((c) => <li key={c.case_number}>{c.case_number} — {partyName(c)}</li>)}</ul>}
            <div className="dashboard-grid" style={{ marginTop: 20 }}>
              <div className="tile purple" onClick={() => chooseMode("new")}>New Deposition</div>
              <div className="tile blue" onClick={() => chooseMode("existing")}>Incomplete Deposition</div>
            </div>
            <div className="form-actions"><button className="btn btn-secondary" onClick={goBackFromWizard}>Back</button></div>
          </>
        )}

        {step === "form" && (
          <>
            <h1>{mode === "new" ? "New Deposition" : "Incomplete Deposition"}</h1>

            {mode === "existing" && (
              <div className="form-grid">
                <label>Select Witness</label>
                <select value={existingId} onChange={(e) => pickExistingWitness(e.target.value)}>
                  <option value="">-- select witness --</option>
                  {existingList.map((w) => (
                    <option key={w.id} value={w.id}>{w.witness_name} (Exh. {w.exhibit_number}, Sr. {w.sr_no})</option>
                  ))}
                </select>
                {existingList.length === 0 && <span className="hint">No incomplete depositions found for this case.</span>}
              </div>
            )}

            {(mode === "new" || existingId) && (
              <div className="form-grid">
                <label>Name of Witness</label>
                <input value={form.witness_name} onChange={(e) => setForm({ ...form, witness_name: e.target.value })} />
                <label>Father's / Husband's Name</label>
                <input value={form.father_husband_name} onChange={(e) => setForm({ ...form, father_husband_name: e.target.value })} />
                <label>Religion</label>
                <input value={form.religion} onChange={(e) => setForm({ ...form, religion: e.target.value })} />
                <label>Age</label>
                <input value={form.age} onChange={(e) => setForm({ ...form, age: e.target.value })} />
                <label>Occupation</label>
                <input value={form.occupation} onChange={(e) => setForm({ ...form, occupation: e.target.value })} />
                <label>Address</label>
                <input value={form.address} onChange={(e) => setForm({ ...form, address: e.target.value })} />
                <label>Contact No. (optional)</label>
                <input value={form.contact_no} onChange={(e) => setForm({ ...form, contact_no: e.target.value })} />
                <label>Language of Deposition</label>
                <select
                  value={form.language}
                  onChange={(e) => {
                    setForm({ ...form, language: e.target.value });
                    // Sync the shared voice-typing mic to this language right
                    // away, so it's already correct for typing the Name/
                    // Address/etc. fields above too, not just once the
                    // typing page itself loads.
                    localStorage.setItem("acjm_mic_lang", e.target.value);
                  }}
                >
                  {LANG_OPTIONS.map((o) => <option key={o.value} value={o.value}>{o.label}</option>)}
                </select>
              </div>
            )}

            {(mode === "new" || existingId) && (
              <div style={{ marginTop: 16, padding: 14, border: "1px solid var(--border)", borderRadius: 6, background: "#fafafa" }}>
                <p className="hint" style={{ marginTop: 0 }}>
                  {selected.length > 1
                    ? <>Enter this witness's <strong>Exhibit Number</strong> and <strong>Sr. No.</strong> for each linked case below — the same witness can carry different numbers in different cases.</>
                    : <>Enter this witness's <strong>Exhibit Number</strong> and <strong>Sr. No.</strong> for this case.</>}
                </p>
                {selected.map((num) => (
                  <div key={num} className="form-grid" style={{ marginBottom: 8 }}>
                    <label>{num} — Exhibit No.</label>
                    <input
                      value={num === activeCaseNumber ? form.exhibit_number : (caseSpecificDetails[num]?.exhibit_number || "")}
                      onChange={(e) => {
                        if (num === activeCaseNumber) setForm({ ...form, exhibit_number: e.target.value });
                        else setCaseSpecificDetails((prev) => ({ ...prev, [num]: { ...prev[num], exhibit_number: e.target.value } }));
                      }}
                    />
                    <label>{num} — Sr. No.</label>
                    <input
                      value={num === activeCaseNumber ? form.sr_no : (caseSpecificDetails[num]?.sr_no || "")}
                      onChange={(e) => {
                        if (num === activeCaseNumber) setForm({ ...form, sr_no: e.target.value });
                        else setCaseSpecificDetails((prev) => ({ ...prev, [num]: { ...prev[num], sr_no: e.target.value } }));
                      }}
                    />
                  </div>
                ))}
              </div>
            )}

            <div className="form-grid" style={{ marginTop: 12 }}>
              <label>Stage of Deposition</label>
              <select value={form.stage} onChange={(e) => setForm({ ...form, stage: e.target.value })}>
                {STAGE_OPTIONS.map((o) => <option key={o.value} value={o.value}>{o.label}</option>)}
              </select>
              <label>Producing Party</label>
              <select value={form.producing_party} onChange={(e) => setProducing(e.target.value)}>
                <option value="">-- select --</option>
                {PARTY_OPTIONS.map((o) => <option key={o.value} value={o.value}>{o.label}</option>)}
              </select>
              <label>Defending Party</label>
              <select value={form.defending_party} onChange={(e) => setForm({ ...form, defending_party: e.target.value })}>
                <option value="">-- select --</option>
                {PARTY_OPTIONS.map((o) => <option key={o.value} value={o.value}>{o.label}</option>)}
              </select>
              <label>Advocate of Producing Party</label>
              <input value={form.advocate_producing} onChange={(e) => setForm({ ...form, advocate_producing: e.target.value })} />
              <label>Advocate of Defending Party</label>
              <input value={form.advocate_defending} onChange={(e) => setForm({ ...form, advocate_defending: e.target.value })} />
            </div>

            <label style={{ display: "flex", alignItems: "center", gap: 8, marginTop: 14 }}>
              <input type="checkbox" checked={form.av_conferencing} onChange={(e) => setForm({ ...form, av_conferencing: e.target.checked })} />
              The deposition of the witness is recorded through audio-video conferencing
            </label>
            <label style={{ display: "flex", alignItems: "center", gap: 8, marginTop: 8 }}>
              <input type="checkbox" checked={form.vulnerable_witness} onChange={(e) => setForm({ ...form, vulnerable_witness: e.target.checked })} />
              Vulnerable Witness
            </label>

            <p className="hint" style={{ marginTop: 14 }}>
              Note: the <strong>Producing Party</strong> is the party who has brought the witness for examination;
              the <strong>Defending Party</strong> is the party who is about to cross-examine the witness.
            </p>

            {msg && <p className="error">{msg}</p>}
            <div className="form-actions">
              <button className="btn btn-secondary" onClick={goBackFromWizard}>Back</button>
              <button className="btn btn-primary" onClick={openConfirm} disabled={submitting}>Proceed</button>
            </div>
          </>
        )}

        {step === "confirm" && (
          <div className="modal-backdrop">
            <div className="modal">
              <h3>Confirm Details</h3>
              <table className="entries">
                <tbody>
                  <tr><td>Witness</td><td>{form.witness_name}</td></tr>
                  <tr><td>Exhibit No.</td><td>{form.exhibit_number}</td></tr>
                  <tr><td>Stage</td><td>{STAGE_OPTIONS.find((o) => o.value === form.stage)?.label}</td></tr>
                  <tr><td>Producing Party</td><td>{PARTY_OPTIONS.find((o) => o.value === form.producing_party)?.label}</td></tr>
                  <tr><td>Defending Party</td><td>{PARTY_OPTIONS.find((o) => o.value === form.defending_party)?.label}</td></tr>
                  <tr><td>Language</td><td>{LANG_OPTIONS.find((o) => o.value === form.language)?.label}</td></tr>
                </tbody>
              </table>
              <label style={{ display: "flex", alignItems: "center", gap: 8, margin: "12px 0" }}>
                <input type="checkbox" id="skip-confirm-cb" />
                Don't show this confirmation again
              </label>
              <div className="modal-actions">
                <button className="btn btn-secondary" onClick={() => setStep("form")}>Edit</button>
                <button
                  className="btn btn-primary"
                  disabled={submitting}
                  onClick={() => {
                    if (document.getElementById("skip-confirm-cb")?.checked) localStorage.setItem(SKIP_CONFIRM_KEY(), "1");
                    doCreate();
                  }}
                >
                  Proceed
                </button>
              </div>
            </div>
          </div>
        )}

        {step === "form" && localStorage.getItem(SKIP_CONFIRM_KEY()) === "1" && (
          <p style={{ marginTop: 10 }}>
            <button className="btn btn-outline" style={{ padding: "4px 10px" }} onClick={() => localStorage.removeItem(SKIP_CONFIRM_KEY())}>
              Re-enable confirmation popup
            </button>
          </p>
        )}
      </div>
    </div>
  );
}

