  const editorRef = useRef(null);
  const savedRangeRef = useRef(null);
  const rulerDragRef = useRef(null);
  const lastKeyDownWasTabRef = useRef(false);
  const historyRef = useRef({
    undoStack: [],
    redoStack: [],
    currentHtml: "",
    isApplyingHistory: false,
    typingBefore: null,
    typingTimer: null,
    isComposing: false,
  });
  // Tracks the largest body_html length seen so far. Used as a sanity check
  // before every save: if the ref is non-null (passing the earlier v7 fix)
  // but content has suddenly collapsed to near-empty compared to
  // substantial content seen moments ago, that's far more likely to be a
  // mid-unmount DOM read (React can clear a node's children during
  // teardown while the ref itself briefly remains non-null) than a
  // genuine, intentional clearing by the user — so the save is skipped
  // rather than trusted.
  const maxSeenLengthRef = useRef(0);
  const isSuspiciouslyEmpty = (html) => {
    const len = (html || "").length;
    if (len > maxSeenLengthRef.current) { maxSeenLengthRef.current = len; return false; }
    return maxSeenLengthRef.current > 50 && len < maxSeenLengthRef.current * 0.15;
  };
  const saveTimer = useRef(null);
  const startRef = useRef(null);
  const finalTimerResumeRef = useRef(null);
  const serverMutationRef = useRef(false);
  const editorHydratedRef = useRef(false);
  const initializedDepositionRef = useRef(null);
  const pendingInitialHtmlRef = useRef(null);
  const editedDuringInitialLoadRef = useRef(false);
  const localVersionRef = useRef(0);
  const latestContentRef = useRef("");
  const revisionRef = useRef(0);
  const pendingServerHtmlRef = useRef(null);
  const reconnectTimerRef = useRef(null);
  const authLostRef = useRef(false);
  const authLostTokenRef = useRef("");
  const draftKey = `dep_draft_${depId}`;

  useEffect(() => {
    try {
      localStorage.setItem(RULER_SETTINGS_KEY, JSON.stringify({ margins: pageMargins, tabStops }));
    } catch (e) { /* ruler preferences are non-critical */ }
  }, [pageMargins, tabStops]);

  useEffect(() => {
    return () => {
      if (pdfPreview?.url) URL.revokeObjectURL(pdfPreview.url);
    };
  }, [pdfPreview?.url]);

  const getCleanEditorHtml = () => {
    const el = editorRef.current;
    if (!el) return "";
    const clone = el.cloneNode(true);
    clone.querySelectorAll(".dep-img-resize-handle").forEach((n) => n.remove());
    clone.querySelectorAll(".dep-table-drop-marker").forEach((n) => n.remove());
    clone.querySelectorAll(".live-sentence").forEach((n) => {
      const parent = n.parentNode;
      while (n.firstChild) parent.insertBefore(n.firstChild, n);
      parent.removeChild(n);
    });
    return clone.innerHTML;
  };
  const updateWordCount = useCallback(() => {
    const text = editorRef.current?.innerText || "";
    setWordCount(countDepositionWords(text));
  }, []);
  const captureCurrentHtml = useCallback(() => {
    const html = editorRef.current ? getCleanEditorHtml() : latestContentRef.current || "";
    latestContentRef.current = html;
    if (html.length > maxSeenLengthRef.current) maxSeenLengthRef.current = html.length;
    updateWordCount();
    return html;
  }, [updateWordCount]);
  const hasMeaningfulEditorContent = useCallback((html) => {
    const wrapper = document.createElement("div");
    wrapper.innerHTML = html || "";
    const text = (wrapper.textContent || "").replace(/\u00a0/g, "").trim();
    return !!text || !!wrapper.querySelector("img, table");
  }, []);
  const logHistory = (event, extra = {}) => {
    if (process.env.NODE_ENV === "production") return;
    const history = historyRef.current;
    console.log(event, {
      source: extra.source,
      htmlLength: extra.htmlLength,
      undoDepth: history.undoStack.length,
      redoDepth: history.redoStack.length,
      depositionId: depId,
      timestamp: Date.now(),
    });
  };
  const refreshHistoryAvailability = () => {
    const history = historyRef.current;
    setHistoryAvailability({
      canUndo: history.undoStack.length > 0 || Boolean(history.typingBefore),
      canRedo: history.redoStack.length > 0,
    });
  };
  const trimHistoryStack = (stack) => {
    while (stack.length > MAX_HISTORY_ENTRIES) stack.shift();
  };
  const nodePathFromEditor = (node) => {
    const editor = editorRef.current;
    if (!editor || !node || !editor.contains(node)) return null;
    const path = [];
    let current = node;
    while (current && current !== editor) {
      const parent = current.parentNode;
      if (!parent) return null;
      path.unshift(Array.prototype.indexOf.call(parent.childNodes, current));
      current = parent;
    }
    return path;
  };
  const nodeFromPath = (path) => {
    let node = editorRef.current;
    if (!node || !Array.isArray(path)) return null;
    for (const index of path) {
      node = node?.childNodes?.[index];
      if (!node) return null;
    }
    return node;
  };
  const captureEditorSelection = () => {
    const editor = editorRef.current;
    const sel = window.getSelection();
    if (!editor || !sel || sel.rangeCount === 0 || !editor.contains(sel.anchorNode)) return null;
    const range = sel.getRangeAt(0);
    return {
      startPath: nodePathFromEditor(range.startContainer),
      startOffset: range.startOffset,
      endPath: nodePathFromEditor(range.endContainer),
      endOffset: range.endOffset,
    };
  };
  const placeCaretAtEditorEnd = () => {
    const editor = editorRef.current;
    if (!editor) return;
    editor.focus();
    const range = document.createRange();
    range.selectNodeContents(editor);
    range.collapse(false);
    const sel = window.getSelection();
    sel.removeAllRanges();
    sel.addRange(range);
  };
  const restoreEditorSelection = (selection) => {
    const editor = editorRef.current;
    if (!editor || !selection) { placeCaretAtEditorEnd(); return; }
    try {
      const startNode = nodeFromPath(selection.startPath);
      const endNode = nodeFromPath(selection.endPath);
      if (!startNode || !endNode) throw new Error("selection path missing");
      const range = document.createRange();
      range.setStart(startNode, Math.min(selection.startOffset || 0, startNode.length ?? startNode.childNodes.length));
      range.setEnd(endNode, Math.min(selection.endOffset || 0, endNode.length ?? endNode.childNodes.length));
      editor.focus();
      const sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(range);
    } catch (e) {
      placeCaretAtEditorEnd();
    }
  };
  const initializeHistory = (html, source = "initial-load") => {
    const history = historyRef.current;
    clearTimeout(history.typingTimer);
    history.undoStack = [];
    history.redoStack = [];
    history.currentHtml = html || "";
    history.typingBefore = null;
    history.isApplyingHistory = false;
    refreshHistoryAvailability();
    logHistory("HISTORY_INITIALIZED", { source, htmlLength: (html || "").length });
  };
  const snapshotEntry = (html, source, selection = captureEditorSelection()) => ({
    html: html || "",
    selection,
    timestamp: Date.now(),
    source,
    intentionalBlank: !hasMeaningfulEditorContent(html || ""),
  });
  const captureHistoryBefore = (source) => {
    const history = historyRef.current;
    if (history.isApplyingHistory || !editorRef.current) return;
    const html = getCleanEditorHtml();
    history.pendingBefore = snapshotEntry(html, source);
  };
  const discardPendingHistory = () => {
    historyRef.current.pendingBefore = null;
  };
  const commitHistoryAfter = (source) => {
    const history = historyRef.current;
    if (history.isApplyingHistory || !history.pendingBefore) return;
    const before = history.pendingBefore;
    history.pendingBefore = null;
    const afterHtml = getCleanEditorHtml();
    if (afterHtml === before.html) return;
    history.undoStack.push(before);
    trimHistoryStack(history.undoStack);
    history.currentHtml = afterHtml;
    if (history.redoStack.length) logHistory("REDO_STACK_CLEARED", { source, htmlLength: afterHtml.length });
    history.redoStack = [];
    refreshHistoryAvailability();
    logHistory("HISTORY_CAPTURED", { source, htmlLength: afterHtml.length });
  };
  const writeTypingDraft = useCallback((html, extra = {}) => {
    try {
      localStorage.setItem(draftKey, JSON.stringify({
        depId,
        html,
        savedAt: Date.now(),
        ...extra,
      }));
    } catch (e) { /* local cache unavailable - server save still protects the record */ }
  }, [depId, draftKey]);

  const buildDocMetadata = useCallback((data = dep) => ({
    depId,
    caseNumber: data?.primary_case_number || "",
    witnessName: data?.witness_name || "",
    language: data?.language || "gu",
    status: data?.status || "in_progress",
    scrollTop: window.scrollY || 0,
  }), [dep, depId]);

  const readLocalStorageDraft = useCallback(() => {
    try {
      return JSON.parse(localStorage.getItem(`dep_draft_${depId}`) || "null");
    } catch (e) {
      return null;
    }
  }, [depId]);

  const bestLocalRecoveryHtml = useCallback((localDoc, localDraft) => {
    const indexedHtml = localDoc?.html || "";
    const draftHtml = localDraft?.html || "";
    if (!hasMeaningfulEditorContent(indexedHtml)) return draftHtml;
    if (!hasMeaningfulEditorContent(draftHtml)) return indexedHtml;
    const draftSavedAt = Number(localDraft?.savedAt || 0);
    const indexedSavedAt = Number(localDoc?.updatedAt || 0);
    return draftSavedAt > indexedSavedAt ? draftHtml : indexedHtml;
  }, [hasMeaningfulEditorContent]);

  const applyEditorHtml = useCallback((html) => {
    pendingInitialHtmlRef.current = html || "";
    latestContentRef.current = pendingInitialHtmlRef.current;
    if (!editorRef.current) return;
    historyRef.current.isApplyingHistory = true;
    editorRef.current.innerHTML = pendingInitialHtmlRef.current;
    maxSeenLengthRef.current = editorRef.current.innerHTML.length;
    updateWordCount();
    initializeHistory(pendingInitialHtmlRef.current, "initial-restore");
    pendingInitialHtmlRef.current = null;
    historyRef.current.isApplyingHistory = false;
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  const setEditorNode = useCallback((node) => {
    editorRef.current = node;
    setEditorInitialized(!!node);
    if (process.env.NODE_ENV !== "production") console.log("EDITOR STATE", {
      editorExists: Boolean(node),
      editorInitialized: Boolean(node),
      initialContentLoading,
      isSaving: saving,
      isNavigatingBack,
      depositionId: depId,
    });
    if (node && pendingInitialHtmlRef.current != null) {
      if (process.env.NODE_ENV !== "production") console.trace("SET_CONTENT_CALLED", { depositionId: depId, contentLength: pendingInitialHtmlRef.current.length, reason: "editor-node-mounted" });
      historyRef.current.isApplyingHistory = true;
      node.innerHTML = pendingInitialHtmlRef.current;
      maxSeenLengthRef.current = node.innerHTML.length;
      latestContentRef.current = node.innerHTML;
      updateWordCount();
      initializeHistory(node.innerHTML, "editor-node-mounted");
      pendingInitialHtmlRef.current = null;
      historyRef.current.isApplyingHistory = false;
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [depId, initialContentLoading, isNavigatingBack, saving, updateWordCount]);

  const persistLocalDocument = useCallback(async (html, extra = {}) => {
    const version = (extra.version || localVersionRef.current + 1);
    localVersionRef.current = Math.max(localVersionRef.current, version);
    revisionRef.current = Math.max(revisionRef.current, version);
    latestContentRef.current = html || "";
    const now = Date.now();
    const doc = {
      depId,
      html,
      json: { type: "html", html },
      version,
      updatedAt: now,
      pendingSync: !!extra.pendingSync,
      serverSyncedAt: extra.serverSyncedAt || null,
      metadata: buildDocMetadata(),
    };
    writeTypingDraft(html, { savedAt: now, version, pendingServerSync: !!extra.pendingSync, serverSyncedAt: extra.serverSyncedAt });
    await idbSaveDocument(doc);
    await idbAddVersion(depId, version, html, doc.metadata);
    return doc;
  }, [buildDocMetadata, depId, writeTypingDraft]);

  const persistLocalDocumentStrict = useCallback(async (html, extra = {}) => {
    const version = (extra.version || localVersionRef.current + 1);
    localVersionRef.current = Math.max(localVersionRef.current, version);
    revisionRef.current = Math.max(revisionRef.current, version);
    latestContentRef.current = html || "";
    const now = Date.now();
    const doc = {
      depId,
      html,
      json: { type: "html", html },
      version,
      updatedAt: now,
      pendingSync: !!extra.pendingSync,
      serverSyncedAt: extra.serverSyncedAt || null,
      metadata: buildDocMetadata(),
    };
    writeTypingDraft(html, { savedAt: now, version, pendingServerSync: !!extra.pendingSync, serverSyncedAt: extra.serverSyncedAt });
    await idbPut(DEP_DOC_STORE, doc);
    await idbAddVersion(depId, version, html, doc.metadata);
    return doc;
  }, [buildDocMetadata, depId, writeTypingDraft]);

  const clearReconnectTimer = useCallback(() => {
    if (reconnectTimerRef.current) {
      clearInterval(reconnectTimerRef.current);
      reconnectTimerRef.current = null;
    }
  }, []);

  const currentAuthToken = useCallback(() => localStorage.getItem("token") || "", []);
  const markAuthLost = useCallback((message) => {
    authLostRef.current = true;
    authLostTokenRef.current = currentAuthToken();
    clearReconnectTimer();
    setSyncStatus("auth-lost");
    setWorkflowMsg(message);
  }, [clearReconnectTimer, currentAuthToken]);

  const shouldPauseServerSyncForAuth = useCallback(() => (
    authLostRef.current && currentAuthToken() === authLostTokenRef.current
  ), [currentAuthToken]);

  const queueAdjournmentLocally = useCallback(async ({ reason, nextDateTime, adjournedFor, editorRevision }) => {
    const record = {
      id: `${depId}:${Date.now()}`,
      depositionId: depId,
      caseId: dep?.primary_case_number || "",
      witnessId: dep?.witness_name || "",
      reason,
