          const c = r.cells[cst.idx];
          if (c) c.style.width = newWidth + "px";
        });
      }
      const rst = rowResizeState.current;
      if (rst) {
        const newHeight = Math.max(20, rst.startHeight + (e.clientY - rst.startY));
        rst.row.style.height = newHeight + "px";
        Array.from(rst.row.cells).forEach((c) => { c.style.height = newHeight + "px"; });
      }
    };
    const onUp = () => {
      if (colResizeState.current) { colResizeState.current = null; commitHistoryAfter("table-column-resize"); scheduleSave(); }
      if (rowResizeState.current) { rowResizeState.current = null; commitHistoryAfter("table-row-resize"); scheduleSave(); }
    };
    document.addEventListener("mousemove", onMove);
    document.addEventListener("mouseup", onUp);
    return () => { document.removeEventListener("mousemove", onMove); document.removeEventListener("mouseup", onUp); };
