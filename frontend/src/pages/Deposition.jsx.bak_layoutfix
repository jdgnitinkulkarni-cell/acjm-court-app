export function DepositionEditDetails() {
  const { depId } = useParams();
  const navigate = useNavigate();
  const [dep, setDep] = useState(null);
  const [form, setForm] = useState(null);
  const [caseSpecificDetails, setCaseSpecificDetails] = useState({});
  const [saving, setSaving] = useState(false);
  const [msg, setMsg] = useState("");

  useEffect(() => {
    api.get(`/depositions/${depId}`).then(({ data }) => {
      setDep(data);
      setForm({
        exhibit_number: data.exhibit_number || "", sr_no: data.sr_no || "",
        witness_name: data.witness_name || "", father_husband_name: data.father_husband_name || "",
        religion: data.religion || "", age: data.age || "", occupation: data.occupation || "",
        address: data.address || "", contact_no: data.contact_no || "",
        stage: data.stage || "chief",
        producing_party: data.producing_party || "", defending_party: data.defending_party || "",
        advocate_producing: data.advocate_producing || "", advocate_defending: data.advocate_defending || "",
        av_conferencing: !!data.av_conferencing, vulnerable_witness: !!data.vulnerable_witness,
        language: data.language || "gu",
      });
      setCaseSpecificDetails(data.case_specific_details || {});
    });
  }, [depId]);

  const save = async () => {
    setSaving(true);
    setMsg("");
